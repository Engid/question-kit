  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "paths": {}
  },
  "include": [
    "core/*.ts",
    "core/methods/*.ts",
    "order/*.ts",
