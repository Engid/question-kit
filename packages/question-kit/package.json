{
  "name": "question-kit",
  "version": "0.4.0",
  "description": "The standard library for System One models, starting with Jev: ready-made methods built by measurement, an order taker, and a service agent you configure.",
  "type": "module",
  "license": "MIT",
  "author": "Nick Gideo",
  "homepage": "https://github.com/Engid/question-kit#readme",
  "bugs": {
    "url": "https://github.com/Engid/question-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Engid/question-kit.git",
    "directory": "packages/question-kit"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system one",
    "decision model",
    "classification",
    "extraction",
    "customer service",
    "agent",
    "order taking",
    "agent skills",
    "tanstack-intent"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./order": {
      "types": "./dist/order/index.d.ts",
      "default": "./dist/order/index.js"
    },
    "./service-agent": {
      "types": "./dist/service-agent/index.d.ts",
      "default": "./dist/service-agent/index.js"
    },
    "./cache": {
      "types": "./dist/core/cache.d.ts",
      "default": "./dist/core/cache.js"
    },
    "./node": {
      "types": "./dist/core/node.d.ts",
      "default": "./dist/core/node.js"
    },
    "./typesafe": {
      "types": "./dist/core/typesafe.d.ts",
      "default": "./dist/core/typesafe.js"
    },
    "./experimental/openrouter": {
      "types": "./dist/experimental/openrouter.d.ts",
      "default": "./dist/experimental/openrouter.js"
    }
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  }
}
