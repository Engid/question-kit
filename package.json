{
  "name": "question-kit-repo",
  "version": "0.0.1",
  "description": "question-kit: the standard library for System One models, starting with Jev. The packages, examples, docs and smoke checks; the Python port is in python/.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "author": "Nick Gideo",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun smoke/run.ts",
    "order:pizza": "bun examples/order/pizza/take-order.ts",
    "service:chat": "bun examples/service-agent/chat.ts",
    "triage": "bun examples/triage/triage.ts",
    "pizza": "bun examples/pizza-shop/chat.ts",
    "pizza:check": "bun examples/pizza-shop/check.ts",
    "pizza:web": "bun examples/pizza-shop/web/server.ts",
    "build": "bun run --cwd packages/question-kit build",
    "clean": "rm -rf packages/question-kit/dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "question-kit": "workspace:*",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.4"
  }
}
